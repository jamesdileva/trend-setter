{
  "name": "trend-setter-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the Coinbase Automated Trend-Follower.",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
